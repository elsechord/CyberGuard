# Copy to /srv/cyberguard/agentteams.env and fill secrets on the server.
AGENTTEAMS_NON_INTERACTIVE=1
AGENTTEAMS_LANGUAGE=zh
AGENTTEAMS_VERSION=v1.2.2
AGENTTEAMS_INSTALL_COMMIT=849182af8e017168a5a200a87b1062142caf462d
AGENTTEAMS_INSTALL_SHA256=8ef28c5bf239a0af2d6b57b946ecee977bf39e6c874cd786b85c7bd094668f9d

AGENTTEAMS_LLM_PROVIDER=deepseek-official
AGENTTEAMS_OPENAI_BASE_URL=https://api.deepseek.com/v1
AGENTTEAMS_LLM_API_KEY=replace-me
AGENTTEAMS_DEFAULT_MODEL=deepseek-v4-flash
AGENTTEAMS_EMBEDDING_MODEL=

AGENTTEAMS_ADMIN_USER=admin
AGENTTEAMS_ADMIN_PASSWORD=replace-with-a-strong-password
AGENTTEAMS_MANAGER_RUNTIME=copaw
AGENTTEAMS_DEFAULT_WORKER_RUNTIME=copaw

AGENTTEAMS_LOCAL_ONLY=1
AGENTTEAMS_MATRIX_E2EE=0
AGENTTEAMS_MOUNT_SOCKET=1
AGENTTEAMS_DOCKER_PROXY=1
AGENTTEAMS_PROXY_ALLOWED_REGISTRIES=higress-registry.cn-hangzhou.cr.aliyuncs.com

AGENTTEAMS_DATA_DIR=agentteams-data
AGENTTEAMS_WORKSPACE_DIR=/srv/cyberguard/agentteams-manager
AGENTTEAMS_HOST_SHARE_DIR=/srv/cyberguard/host-share
AGENTTEAMS_WORKER_IDLE_TIMEOUT=120
AGENTTEAMS_DASHBOARD=1
AGENTTEAMS_PORT_DASHBOARD=13000

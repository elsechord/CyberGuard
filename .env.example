# Copy to .env on the server. Never commit the real file.
CYBERGUARD_API_TOKEN=replace-with-a-long-random-token
CYBERGUARD_EXECUTOR_TOKEN=replace-with-a-different-long-random-token
CYBERGUARD_APPROVAL_SECRET=replace-with-a-third-long-random-secret
CYBERGUARD_AUDIT_HMAC_KEY=replace-with-a-fourth-long-random-secret
CYBERGUARD_AUDIT_READER_TOKEN=replace-with-a-fifth-long-random-token
# Optional investigation intake/report roles; initializer generates distinct values.
CYBERGUARD_INVESTIGATION_INGEST_TOKEN=
CYBERGUARD_REPORT_TOKEN=
CYBERGUARD_LOG_LEVEL=INFO
CYBERGUARD_DATA_DIR=/data

# Optional production connectors. The starter runs entirely in simulation mode.
CYBERGUARD_VT_API_KEY=
CYBERGUARD_OTX_API_KEY=
CYBERGUARD_MISP_URL=
CYBERGUARD_MISP_API_KEY=

# Generic live connectors. Leave empty for deterministic competition scenarios.
CYBERGUARD_ALLOW_INSECURE_HTTP=0
CYBERGUARD_MIN_EVIDENCE_QUALITY=0.7
CYBERGUARD_SIEM_BASE_URL=
CYBERGUARD_SIEM_TOKEN=
CYBERGUARD_NDR_BASE_URL=
CYBERGUARD_NDR_TOKEN=
CYBERGUARD_FIREWALL_BASE_URL=
CYBERGUARD_FIREWALL_TOKEN=
CYBERGUARD_EDR_BASE_URL=
CYBERGUARD_EDR_TOKEN=
CYBERGUARD_CMDB_BASE_URL=
CYBERGUARD_CMDB_TOKEN=

# Operations console (services/operations-console). It reuses the gateway token
# and the approval secret generated above: leave CYBERGUARD_GATEWAY_TOKEN empty
# to reuse CYBERGUARD_API_TOKEN, or fill it when the gateway issued the console
# a dedicated bearer token. The GUARD_* pair is optional and enables the
# model-guard integration (set CYBERGUARD_GUARD_URL to the guard's agentteams
# alias, e.g. http://model-guard.agentteams.local:8080); the admin token must
# match the token configured in the model-guard's private env file. Keep cookie
# Secure semantics enabled except on an isolated plain-HTTP lab host.
CYBERGUARD_GATEWAY_TOKEN=
CYBERGUARD_GUARD_URL=
CYBERGUARD_GUARD_ADMIN_TOKEN=
CYBERGUARD_COOKIE_SECURE=true
# Canonical origin reachable by your Agent (HTTPS, no path). Loopback can be
# inferred for local use; remote deployments must set this explicitly.
CYBERGUARD_CONSOLE_ORIGIN=
# Optional actual AgentTeams Matrix backend for durable investigation jobs.
# Configure a dedicated service account and three read-only/report-only Workers.
# Keep credentials private; no model key is needed in the external Skill.
CYBERGUARD_INVESTIGATION_DISPATCH_ENABLED=true
# Optional: wait for the configured model guard to be armed before new work.
# Requires CYBERGUARD_GUARD_URL and CYBERGUARD_GUARD_ADMIN_TOKEN.
CYBERGUARD_INVESTIGATION_REQUIRE_GUARD_ARMED=false
CYBERGUARD_AGENTTEAMS_BACKEND=native
CYBERGUARD_AGENTTEAMS_CONTROLLER_URL=
CYBERGUARD_AGENTTEAMS_CONTROLLER_TOKEN=
CYBERGUARD_AGENTTEAMS_TEAM_ID=
CYBERGUARD_AGENTTEAMS_LEADER_ROOM_ID=
CYBERGUARD_AGENTTEAMS_LEADER_USER_ID=
CYBERGUARD_AGENTTEAMS_MATRIX_URL=
CYBERGUARD_AGENTTEAMS_MATRIX_TOKEN=
CYBERGUARD_AGENTTEAMS_MATRIX_USER=
CYBERGUARD_AGENTTEAMS_MATRIX_PASSWORD=
CYBERGUARD_AGENTTEAMS_MATRIX_HOST=
CYBERGUARD_AGENTTEAMS_ELEMENT_URL=
CYBERGUARD_AGENTTEAMS_ROLES_JSON=
CYBERGUARD_AGENTTEAMS_STAGE_TIMEOUT_SECONDS=300
